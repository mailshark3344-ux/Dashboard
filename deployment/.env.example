# PostgreSQL
POSTGRES_DB=redash
POSTGRES_USER=redash
POSTGRES_PASSWORD=<SET_BY_TARGET_TEAM>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redash
REDASH_DATABASE_URL=postgresql://redash:<PASSWORD>@postgres:5432/redash
REDASH_REDIS_URL=redis://redis:6379/0
REDASH_COOKIE_SECRET=<SET_BY_TARGET_TEAM>
REDASH_SECRET_KEY=<SET_BY_TARGET_TEAM>
REDASH_GUNICORN_TIMEOUT=120

REDASH_URL=http://<TARGET-REDASH-HOST>:5000
REDASH_DASHBOARD_PATH=/dashboards/1-dashboard

# MinIO - provided by target system
MINIO_ENDPOINT=<TARGET-MINIO-ENDPOINT>
MINIO_ACCESS_KEY=<TARGET-MINIO-ACCESS-KEY>
MINIO_SECRET_KEY=<TARGET-MINIO-SECRET-KEY>
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_BUCKETS=
MINIO_PREFIX=

# CDC
POLL_INTERVAL=10
FORCE_REPROCESS=false
